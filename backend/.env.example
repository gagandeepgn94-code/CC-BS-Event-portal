# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ccbs_events

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_super_secret_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Seed Passwords (used only during initial seed_admin.py execution) ─────────
SEED_ADMIN_PASSWORD=your_strong_admin_password_here
SEED_COORD_PASSWORD=your_strong_coord_password_here

# ── AWS S3 Storage (Leave empty for automatic local storage fallback) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
